pipeline {
    agent any
    stages {
        stage('pull'){
            steps {
                git branch: 'dev', url: 'https://github.com/shubhamkalsait/b19-backend.git'
            }
        }
        stage('build'){
            steps {
                sh '/opt/maven/bin/mvn clean package'
            }
        }
        stage('test'){
            steps {
                withSonarQubeEnv(installationName: 'sonar', credentialsId: 'sonar-cred') {
                    sh '/opt/maven/bin/mvn sonar:sonar -Dsonar.projectKey=backend'
                }
            }
        }
        stage('QualityGate'){
            steps {
                timeout(10) {
                    waitForQualityGate abortPipeline: true, credentialsId: 'sonar-cred'
                }
            }
        }
        stage('deploy'){
            steps {
                sh '''
                    docker build . -t shubhamkalsait1/b19-backend:latest
                    docker push shubhamkalsait1/b19-backend:latest
                    docker rmi shubhamkalsait1/b19-backend:latest
                    kubectl apply -f ./yaml/
                '''
            }
        }
    }
}